APP_NAME="Brothers Bets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch — monitoring. OFF locally (no agent runs
# here). On Laravel Cloud, enabling Monitoring injects the token,
# sample rate, and log stack automatically. Never commit a token.
NIGHTWATCH_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Avatars are stored on the default disk. Production points this at the attached
# (private) object-storage bucket; locally the public disk serves them over HTTP.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production sends via Cloudflare Email Service: set MAIL_MAILER=cloudflare and the two keys below.
# Requires the sending domain to use Cloudflare DNS with domain onboarding completed (SPF/DKIM/DMARC).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KEY=

# Object storage (production). The `s3` disk is S3-compatible and works with Cloudflare R2:
# set FILESYSTEM_DISK to the bucket disk, AWS_DEFAULT_REGION=auto, AWS_ENDPOINT to the R2
# S3 API endpoint, and AWS_URL to the bucket's base URL. On Laravel Cloud most of these are
# injected when a bucket is attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emails granted application admin access (App\Models\User::isAdmin).
ADMIN_EMAILS=

# Minutes after kickoff a match is considered finished and eligible for an official score.
SCORING_MATCH_DURATION_MINUTES=150
# Local only: have scores:fetch propose simulated results for ended fixtures (vs. manual entry).
SCORING_SIMULATED_PROVIDER=false
